// Production secrets for the client app's iOS Info.plist substitutions.
//
// You should NEVER write this file by hand or commit a populated copy.
// `tool/build.sh client ios` regenerates `Secrets.xcconfig` from
// `.env.prod` on every build — the active file is gitignored.
//
// This `.example` is committed only to document which keys the iOS
// build chain expects. If you add a new $(VARIABLE) substitution in
// Info.plist, document it here.

GOOGLE_MAPS_API_KEY = REPLACE_AT_BUILD_TIME

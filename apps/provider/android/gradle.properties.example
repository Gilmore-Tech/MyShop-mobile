org.gradle.jvmargs=-Xmx8G -XX:MaxMetaspaceSize=4G -XX:ReservedCodeCacheSize=512m -XX:+HeapDumpOnOutOfMemoryError
android.useAndroidX=true
# Set this to your local Android Studio JBR path if `flutter doctor` can't find Java 17.
# org.gradle.java.home=/Applications/Android Studio.app/Contents/jbr/Contents/Home
# Google Maps SDK key — populated by `tool/run.sh` from `.env.dev` on every run.
# If you build via `flutter build` directly, set this manually.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

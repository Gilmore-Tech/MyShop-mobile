# Local-dev keys for `tool/run.sh`. Copy to `.env.dev` (gitignored)
# and fill in the real values from the Paystack / Google Maps / Mapbox /
# Firebase consoles.
#
#   cp .env.dev.example .env.dev
#   tool/run.sh client
#
# The shell script sources this file and passes every variable through
# to `flutter run` as a `--dart-define`. Same names as the keys read by
# `MapsConfig.apiKey` / `MapboxConfig.accessToken` / `MapboxConfig.styleUrl`.

# One dev Maps key is enough for local testing — `tool/run.sh` uses this for
# every (app, platform) unless a more specific key below is set.
GOOGLE_MAPS_API_KEY=...replace-me...

# Optional: if your dev keys are restricted per app/platform, set any of these
# and run.sh picks the one matching `tool/run.sh <app> [android|ios]`. Unset
# ones fall back to the generic GOOGLE_MAPS_API_KEY above.
# GOOGLE_MAPS_API_KEY_CLIENT_ANDROID=...
# GOOGLE_MAPS_API_KEY_CLIENT_IOS=...
# GOOGLE_MAPS_API_KEY_PROVIDER_ANDROID=...
# GOOGLE_MAPS_API_KEY_PROVIDER_IOS=...

# Android debug-keystore SHA-1 (colon-separated, uppercase). Sent as the
# X-Android-Cert header so an app-restricted dev key accepts direct REST calls
# (Places/Directions/Roads/Static Maps). The debug keystore is shared across
# both apps, so this one generic value normally covers client and provider.
# Get it with:
#   keytool -list -v -keystore ~/.android/debug.keystore \
#     -alias androiddebugkey -storepass android -keypass android | grep SHA1
# Leave unset if your dev key has no Android application restriction.
# MAPS_ANDROID_CERT_SHA1=AA:BB:CC:...debug-sha1...

MAPBOX_ACCESS_TOKEN=...replace-me...
MAPBOX_STYLE_URL=mapbox://styles/your-account/your-style-id

# Optional: override the backend URL when pointing at a non-default env.
# Leave commented to use the value baked into apiConfigProvider.
# API_BASE_URL=https://staging-api.myshop.com.gh

# Local-dev keys for `tool/run.sh`. Copy to `.env.dev` (gitignored)
# and fill in the real values from the Paystack / Google Maps / Mapbox /
# Firebase consoles.
#
#   cp .env.dev.example .env.dev
#   tool/run.sh client
#
# The shell script sources this file and passes every variable through
# to `flutter run` as a `--dart-define`. Same names as the keys read by
# `MapsConfig.apiKey` / `MapboxConfig.accessToken` / `MapboxConfig.styleUrl`.

GOOGLE_MAPS_API_KEY=...replace-me...
MAPBOX_ACCESS_TOKEN=...replace-me...
MAPBOX_STYLE_URL=mapbox://styles/your-account/your-style-id

# Optional: override the backend URL when pointing at a non-default env.
# Leave commented to use the value baked into apiConfigProvider.
# API_BASE_URL=https://staging-api.myshop.com.gh

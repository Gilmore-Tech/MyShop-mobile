# PRODUCTION-restricted keys for `tool/build.sh`. Copy to `.env.prod`
# (gitignored) and fill in the real values from the Google / Mapbox /
# Paystack / Firebase consoles.
#
#   cp .env.prod.example .env.prod
#   tool/build.sh client android        # selects GOOGLE_MAPS_API_KEY_CLIENT_ANDROID
#   tool/build.sh client ios            # selects GOOGLE_MAPS_API_KEY_CLIENT_IOS
#   tool/build.sh provider android      # selects GOOGLE_MAPS_API_KEY_PROVIDER_ANDROID
#   tool/build.sh provider ios          # selects GOOGLE_MAPS_API_KEY_PROVIDER_IOS
#
# Google Maps keys are restricted per app AND per platform (an Android key
# carries an Android app restriction, an iOS key an iOS one — they can't be
# the same key), so there are four. build.sh selects the one matching the
# (app, platform) you build and threads it into both the Dart `--dart-define`
# and the native Maps SDK (Android gradle.properties / iOS Secrets.xcconfig).

GOOGLE_MAPS_API_KEY_CLIENT_ANDROID=...client-android-key...
GOOGLE_MAPS_API_KEY_CLIENT_IOS=...client-ios-key...
GOOGLE_MAPS_API_KEY_PROVIDER_ANDROID=...provider-android-key...
GOOGLE_MAPS_API_KEY_PROVIDER_IOS=...provider-ios-key...

# Android signing-cert SHA-1 (colon-separated, uppercase — keytool format),
# per app. Sent as the X-Android-Cert header so an Android-restricted key
# accepts the apps' direct REST calls (Places / Directions / Roads / Static
# Maps). It must match a fingerprint whitelisted on that Android key — use
# the Play App Signing SHA-1 (and/or the upload-key SHA-1) for store builds.
# Not used by iOS builds.
MAPS_ANDROID_CERT_SHA1_CLIENT=AA:BB:CC:...client-play-or-upload-sha1...
MAPS_ANDROID_CERT_SHA1_PROVIDER=AA:BB:CC:...provider-play-or-upload-sha1...

# Mapbox (artisan navigation) — single token, shared by both apps.
MAPBOX_ACCESS_TOKEN=...replace-me...
MAPBOX_STYLE_URL=mapbox://styles/your-account/your-style-id

# PRODUCTION backend. Keep the /v1 suffix (wsBaseUrl strips it for Socket.IO).
API_BASE_URL=https://api.myshop.com.gh/v1
